# Client — intégrées au bundle, donc PUBLIQUES. Aucun secret ici.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Identité éditeur (mentions légales) — obligatoire avant toute vente au
# public en France. Non préfixées différemment de VITE_SUPABASE_* pour
# rappeler qu'elles restent À COMPLÉTER avant commercialisation ; elles
# sont tout de même publiques une fois le bundle construit (mentions
# légales = information publique par nature). Voir apps/web/src/lib/legal.ts.
# VITE_LEGAL_PUBLISHER_NAME=
# VITE_LEGAL_PUBLISHER_FORM=
# VITE_LEGAL_PUBLISHER_SIREN=
# VITE_LEGAL_PUBLISHER_ADDRESS=
# VITE_LEGAL_PUBLISHER_DIRECTOR=
# VITE_LEGAL_CONTACT_EMAIL=
# VITE_LEGAL_MEDIATOR=

# Serveur uniquement — à définir dans Vercel, JAMAIS préfixées VITE_.
# SUPABASE_SERVICE_ROLE_KEY=
# AI_ASSISTANT_API_TOKEN=
